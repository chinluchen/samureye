rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUserKeys() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'gameCenterPlayerId',
        'displayName',
        'alias',
        'createdAt',
        'updatedAt',
        'lastLoginAt'
      ]);
    }

    function validUserTypes(uid) {
      return request.resource.data.uid is string
        && request.resource.data.uid == uid
        && request.resource.data.gameCenterPlayerId is string
        && request.resource.data.displayName is string
        && request.resource.data.alias is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastLoginAt is timestamp;
    }

    function validUserCreate(uid) {
      return validUserKeys()
        && validUserTypes(uid)
        && request.resource.data.createdAt is timestamp;
    }

    function validUserUpdate(uid) {
      return validUserKeys()
        && validUserTypes(uid)
        && resource.data.createdAt is timestamp
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validProgressKeys() {
      return request.resource.data.keys().hasOnly([
        'level',
        'sp',
        'learnedSkills',
        'equippedSkills',
        'stats',
        'stageProgress',
        'questionProgress',
        'updatedAt',
        'schemaVersion'
      ]);
    }

    function validProgressTypes() {
      return request.resource.data.level is int
        && request.resource.data.level >= 0
        && request.resource.data.sp is int
        && request.resource.data.sp >= 0
        && request.resource.data.learnedSkills is list
        && request.resource.data.equippedSkills is list
        && request.resource.data.stats is map
        && request.resource.data.stageProgress is map
        && request.resource.data.questionProgress is map
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && request.resource.data.updatedAt is timestamp;
    }

    function validProgressWrite() {
      return validProgressKeys() && validProgressTypes();
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUserCreate(uid);
      allow update: if isOwner(uid) && validUserUpdate(uid);
      allow delete: if false;

      match /progress/{docId} {
        allow read: if isOwner(uid) && docId == 'main';
        allow create: if isOwner(uid) && docId == 'main' && validProgressWrite();
        allow update: if isOwner(uid) && docId == 'main' && validProgressWrite();
        allow delete: if false;
      }
    }
  }
}
